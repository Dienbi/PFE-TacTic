@startuml release1_use_case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Release 1 — Authentication, User Management and Attendance

actor "Employee" as Emp
actor "Team Leader" as Chef
actor "HR Administrator" as RH

Emp <|-- Chef
Chef <|-- RH

rectangle "TAC-TIC HR System\n(Release 1 — Sprint 1 & 2)" as System {

  package "Sprint 1 — Authentication & User Management" {
    usecase "Authenticate" as UC_Auth
    usecase "Create Account" as UC_Register
    usecase "Edit Profile" as UC_Profile
    usecase "View and Verify Employee Data" as UC_ViewEmp
    usecase "Manage Employee Records" as UC_ManageEmp
    usecase "Assign Roles" as UC_Roles
    usecase "Manage User Status" as UC_Status
    usecase "Validate Signups" as UC_ValidateSignup
  }

  package "Sprint 2 — Attendance" {
    usecase "Check In" as UC_CheckIn
    usecase "Check Out" as UC_CheckOut
    usecase "View Attendance History" as UC_History
    usecase "Automatic Check-out" as UC_AutoOut
    usecase "Check Attendance Anomalies" as UC_Anomalies
  }

  UC_Auth ..> UC_Profile : <<extend>>
  UC_ManageEmp ..> UC_Roles : <<include>>
}

Emp --> UC_Auth
Emp --> UC_Register
Emp --> UC_Profile
Emp --> UC_CheckIn
Emp --> UC_CheckOut
Emp --> UC_History
Emp --> UC_AutoOut

Chef --> UC_History
Chef --> UC_ViewEmp

RH --> UC_ViewEmp
RH --> UC_ManageEmp
RH --> UC_Roles
RH --> UC_Status
RH --> UC_ValidateSignup
RH --> UC_Anomalies

@enduml
