# Auto-written by scripts/start-platform.ps1 or scripts/start-platform.sh
# Copy to docker/.env.runners manually if you prefer plain docker compose.
#
# Get a fresh token: GitHub repo → Settings → Actions → Runners → New self-hosted runner (Linux)
# IMPORTANT: use the REPOSITORY runners page, not organization-level runners.
# Tokens expire after ~1 hour — refresh the page and copy a new token right before starting.
#
# Recommended (prompts for token, starts platform + 4 runners):
#   .\scripts\start-platform.ps1 -Build -RunnerToken "YOUR_FRESH_TOKEN"
#   ./scripts/start-platform.sh --build
#
# Manual equivalent:
#   docker compose --env-file docker/.env.runners -f docker/docker-compose.platform.yml up -d --build
#   docker compose --env-file docker/.env.runners -f docker/docker-compose.platform.yml up -d --force-recreate --no-deps github-runner-1 github-runner-2 github-runner-3 github-runner-4

GITHUB_RUNNER_REPO_URL=https://github.com/Dienbi/PFE-TacTic
GITHUB_RUNNER_TOKEN=PASTE_A_FRESH_RUNNER_REGISTRATION_TOKEN_HERE
